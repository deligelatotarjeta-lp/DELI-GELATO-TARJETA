# ============================================================
# DELI GELATO — Variables de entorno
# Copia este archivo como ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" a un repositorio público.
# ============================================================

# Puerto del servidor web
PORT=3000

# Entorno: "development" o "production"
NODE_ENV=development

# URL pública de la plataforma (sin barra final)
# En producción DEBE ser https://
BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# SEGURIDAD
# ------------------------------------------------------------
# Clave secreta para firmar cookies de sesión. Debe ser larga y aleatoria.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# ------------------------------------------------------------
# ADMINISTRADOR PRINCIPAL
# ------------------------------------------------------------
# Correo del administrador principal (fijo, no se puede registrar desde la web)
ADMIN_EMAIL=deligelatotarjeta@gmail.com

# Contraseña del administrador principal.
# Si se define, se aplica en CADA arranque: el administrador principal siempre
# tendrá esta contraseña, aunque la base de datos se reinicie o se redespliegue.
# Para cambiarla, cambia este valor.
# Si se deja vacío, el sistema genera una aleatoria la primera vez y la muestra
# UNA SOLA VEZ en la consola.
ADMIN_PASSWORD=

# ------------------------------------------------------------
# CORREO SALIENTE (opcional, para verificar email y recuperar contraseña)
# ------------------------------------------------------------
# Si no se configura, el sistema NO envía correos: los enlaces de
# verificación/recuperación se muestran solo en la consola (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DELI GELATO <no-reply@deligelato.bo>"
