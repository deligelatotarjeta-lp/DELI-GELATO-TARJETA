# ============================================================
# DELI GELATO — Variables de entorno para PRODUCCIÓN
# Copia este archivo como ".env" en el servidor y rellena los valores.
# NUNCA subas el archivo ".env" a un repositorio público.
# ============================================================

# Entorno de producción (activa cookies Secure y avisos de seguridad)
NODE_ENV=production

# Puerto interno del servidor (la mayoría de plataformas lo asignan solas)
PORT=3000

# URL pública real. OBLIGATORIO usar https:// en producción.
# En Render puedes dejarla vacía: se usa RENDER_EXTERNAL_URL automáticamente.
BASE_URL=https://tu-dominio.com

# ------------------------------------------------------------
# SEGURIDAD
# ------------------------------------------------------------
# Clave secreta larga y aleatoria. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

# ------------------------------------------------------------
# ADMINISTRADOR PRINCIPAL
# ------------------------------------------------------------
ADMIN_EMAIL=deligelatotarjeta@gmail.com
# Si se define, se aplica en CADA arranque: el administrador principal siempre
# tendrá esta contraseña, aunque la base de datos se reinicie o el servicio se
# redespliegue (recomendado en producción). Para cambiarla, cambia este valor.
# Si se deja vacío, el sistema genera una aleatoria la primera vez y la muestra
# UNA SOLA VEZ en los registros del servidor.
ADMIN_PASSWORD=

# ------------------------------------------------------------
# BASE DE DATOS (opcional)
# ------------------------------------------------------------
# Ruta del archivo SQLite. Si no se define, usa data/deligelato.sqlite
# En plataformas con disco persistente, apunta al disco montado. Ejemplo Render:
# DB_PATH=/opt/render/project/src/data/deligelato.sqlite
# DB_PATH=

# ------------------------------------------------------------
# CORREO SALIENTE (opcional, para verificar email y recuperar contraseña)
# ------------------------------------------------------------
# Ejemplo con Gmail (requiere una "contraseña de aplicación", no la normal):
#   1. Activa la verificación en dos pasos en tu cuenta de Google.
#   2. Crea una contraseña de aplicación en https://myaccount.google.com/apppasswords
#   3. Pega aquí los 16 caracteres que te dé Google (sin espacios).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DELI GELATO <deligelatotarjeta@gmail.com>"
